{
  "role": "stub-agent",
  "data_clearance": "internal",
  "max_delegation_depth": 0,
  "tools": [
    {
      "name": "echo",
      "executor": "echo",
      "kind": "structured",
      "direction": "inbound",
      "max_calls_per_task": 3,
      "args_schema": {
        "type": "object",
        "properties": {
          "msg": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "msg"
        ]
      }
    },
    {
      "name": "jira_read",
      "executor": "jira",
      "kind": "structured",
      "direction": "inbound",
      "resource_arg": "ticket_id",
      "secret_path": "demo/jira",
      "egress_hosts": [
        "127.0.0.1:9811"
      ],
      "redact": [
        "summary"
      ],
      "result_sensitivity": 1,
      "args_schema": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]+$"
          }
        },
        "required": [
          "ticket_id"
        ]
      }
    },
    {
      "name": "jira_update",
      "executor": "jira",
      "kind": "structured",
      "direction": "outbound",
      "resource_arg": "ticket_id",
      "secret_path": "demo/jira",
      "egress_hosts": [
        "127.0.0.1:9811"
      ],
      "sensitivity_floor": 7,
      "args_schema": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ]
          }
        },
        "required": [
          "ticket_id",
          "status"
        ]
      }
    },
    {
      "name": "slack_post",
      "executor": "slack",
      "kind": "freeform",
      "direction": "outbound",
      "resource_arg": "channel",
      "secret_path": "demo/slack",
      "egress_hosts": [
        "127.0.0.1:9811"
      ],
      "args_schema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "#triage-internal",
              "#general"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "channel",
          "text"
        ]
      }
    },
    {
      "name": "detokenize",
      "executor": "governor",
      "kind": "structured",
      "direction": "inbound",
      "resource_arg": "token",
      "args_schema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^tok_[0-9a-f]{8}$"
          }
        },
        "required": [
          "token"
        ]
      }
    }
  ]
}
